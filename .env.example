# Application Port
PORT=3000

# MongoDB Connection String (Supports local or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/ocpi_simulator
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/ocpi_simulator?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ocpi_simulator

# Simulator Public/Base URL (used in OCPI versions and endpoints)
OCPI_BASE_URL=http://localhost:3000

# Inbound Bootstrap Token (expected from partner during initial registration POST)
OCPI_INBOUND_BOOTSTRAP_TOKEN=replace-with-inbound-bootstrap-token

# Local Persistent Credentials Token (leave blank to auto-generate)
OCPI_LOCAL_TOKEN=
